{
  "name": "docs-modxpro",
  "version": "1.0.0",
  "repository": "https://github.com/modx-pro/Docs.git",
  "type": "module",
  "contributors": [
    {
      "name": "Bochkarev Ivan",
      "email": "ivanx86@gmail.com"
    },
    {
      "name": "Gulomov Bakhtovar",
      "email": "gulomovcreative@gmail.com"
    }
  ],
  "license": "MIT",
  "scripts": {
    "dev": "vitepress dev",
    "build": "pnpm run generate:og && NODE_OPTIONS=--max-old-space-size=10240 vitepress build",
    "generate:og": "node scripts/generate-og-images.mjs",
    "preview": "vitepress preview",
    "generate": "plop",
    "typecheck": "vue-tsc --noEmit -p .",
    "lint": "node scripts/markdownlint.mjs",
    "lint:changed": "node scripts/markdownlint.mjs --changed",
    "lint:fix": "markdownlint \"**/*.md\" --fix",
    "spellcheck": "node scripts/spellcheck.mjs",
    "spellcheck:fix": "node scripts/spellcheck.mjs --show-suggestions",
    "spellcheck:changed": "node scripts/spellcheck.mjs --changed",
    "check:links": "node scripts/check-markdown-links.mjs",
    "check:links:external": "node scripts/check-markdown-links.mjs --external",
    "check:links:changed": "node scripts/check-markdown-links.mjs --changed",
    "check:sync": "node scripts/check-docs-sync.mjs",
    "check:sync:changed": "node scripts/check-docs-sync.mjs --changed",
    "check:structure": "node scripts/check-docs-structure-sync.mjs",
    "check:structure:changed": "node scripts/check-docs-structure-sync.mjs --changed --warn"
  },
  "devDependencies": {
    "@braintree/sanitize-url": "^7.1.2",
    "@cspell/dict-ru_ru": "^2.3.2",
    "@gulomov/fenom-tmlanguage": "^2.1.3",
    "@gulomov/modx-tmlanguage": "^2.1.0",
    "@modix/smarty-tmlanguage": "^1.1.0",
    "@nolebase/vitepress-plugin-enhanced-readabilities": "^2.18.2",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^22.20.2",
    "cspell": "^10.3.1",
    "cytoscape": "^3.34.3",
    "cytoscape-cose-bilkent": "^4.1.0",
    "dayjs": "^1.11.23",
    "debug": "^4.4.3",
    "dotenv": "^17.4.2",
    "fast-glob": "^3.3.3",
    "gray-matter": "^4.0.3",
    "markdown-it": "^14.3.2",
    "markdown-it-kbd": "^3.0.2",
    "markdownlint": "^0.41.1",
    "markdownlint-cli": "^0.49.1",
    "mermaid": "^12.0.0",
    "plop": "^4.0.5",
    "react": "^19.3.0",
    "satori": "^0.33.4",
    "sharp": "^0.35.4",
    "shiki": "^4.4.3",
    "transliteration": "^2.6.1",
    "typescript": "^6.0.3",
    "vitepress": "2.0.0-alpha.20",
    "vitepress-plugin-mermaid": "^2.0.17",
    "vue": "^3.5.42",
    "vue-tsc": "^3.3.11"
  },
  "dependencies": {
    "@vueuse/core": "^14.4.0",
    "@xobotyi/scrollbar-width": "^1.9.5",
    "glightbox": "^3.3.1",
    "uuid": "^14.0.2"
  },
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@12.6.0+sha512.3ef68f951cb111ac204b4a5a16f0b2ddf0da56a96e0413e81d855d9f0b55ef926714709028e1cd00c405c2c5fb7b9e8ec4dc46777c805d0373c2f2ff00fd20ec"
}
