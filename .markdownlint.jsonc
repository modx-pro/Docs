{
    "line-length": false,
    "link-fragments": false,
    "no-inline-html": {
        "allowed_elements": [
            "Badge",
            "DocsComponentsList",
            "ul",
            "ol",
            "li",
            "small",
            "sub",
            "sup",
            "br"
        ]
    },
    "fenced-code-language": false,
    "no-duplicate-heading": {
        "siblings_only": true
    },
    "single-title": {
        "front_matter_title": ""
    },
    "no-blanks-blockquote": false,
    // было отключено флагом --disable MD045 в скрипте lint
    "no-alt-text": false,
    // выравнивание столбцов таблиц на отображение не влияет, а правило дало ~10 000 замечаний
    "table-column-style": false
}
