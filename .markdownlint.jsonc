{
    "line-length": false,
    "link-fragments": false,
    "no-inline-html": {
        "allowed_elements": [
            "Badge",
            "DocsComponentsList",
            "DocsComponentsCatalog",
            "ul",
            "ol",
            "li",
            "small",
            "sub",
            "sup",
            "br"
        ]
    },
    "fenced-code-language": false,
    "no-duplicate-heading": {
        "siblings_only": true
    },
    "single-title": {
        "front_matter_title": ""
    },
    "no-blanks-blockquote": false,
    // картинок без alt в документации ~600; раньше отключалось флагом --disable MD045 в package.json
    "no-alt-text": false,
    // выравнивание столбцов таблиц на отображение не влияет, а правило давало ~10 300 замечаний
    "table-column-style": false
}
